# Copie para .env (ignorado pelo Git) e preencha. Nunca versione chaves.
GEMINI_API_KEY=
GEMINI_MODEL=
# Nível de raciocínio do modelo (padrão: minimal). Deixe como está; esvazie só se o modelo recusar a configuração.
# GEMINI_PENSAMENTO=minimal
# Token do operador: sem ele, confirmar ou descartar ocorrências fica desativado.
OPERADOR_TOKEN=
# Origem permitida para um front-end hospedado fora do servidor (CORS). Vazio = mesma origem.
CORS_ORIGEM=
